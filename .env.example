# ---------------------------------------------------------------------------
# HyrumHaircuts: browser-safe configuration.
#
# Copy to .env for local development, and set the same four values in
# Netlify > Site configuration > Environment variables for production.
#
# EVERYTHING in this file ends up in the public JavaScript bundle. Only put
# values here that are safe for the whole world to see:
#   - the project URL
#   - the PUBLISHABLE key (sb_publishable_...) or, on older projects, the anon key
#
# NEVER put any of these here or in any VITE_* variable:
#   secret keys (sb_secret_...), the service_role key, the database password,
#   access tokens, or SMTP credentials. The app refuses to start if it finds one.
# ---------------------------------------------------------------------------

# Supabase Dashboard > Project Settings > API (Project URL)
VITE_SUPABASE_URL=

# Supabase Dashboard > Project Settings > API Keys > Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Used to namespace the admin session in the browser. Leave as is.
VITE_SITE_SLUG=hyrumhaircuts

# Public address of the site (used for robots.txt and sitemap.xml at build time).
VITE_SITE_URL=https://hyrumhaircuts.com
