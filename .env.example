# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# --- Application ---
APP_NAME="HyrumHaircuts"
APP_ENV=local
# development | production
APP_DEBUG=true
# Show detailed errors when true. Always false in production.
APP_URL=http://localhost:8000
APP_TIMEZONE="America/Denver"
APP_KEY=
# Random 32+ char string used to sign booking cancellation/view tokens.
# Generate one with: php bin/generate-key.php

# --- Database ---
DB_CONNECTION=sqlite
# sqlite | mysql
DB_DATABASE=storage/database/hyrumhaircuts.sqlite
# Path to the SQLite file, relative to the project root.

# MySQL settings (only used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_MYSQL_DATABASE=hyrumhaircuts
DB_USERNAME=
DB_PASSWORD=

# --- Mail ---
MAIL_DRIVER=log
# log (default, writes to storage/mail/) | smtp
MAIL_FROM_ADDRESS=no-reply@hyrumhaircuts.example
MAIL_FROM_NAME="HyrumHaircuts"
MAIL_OWNER_ADDRESS=hyrum@hyrumhaircuts.example
# Where new booking-request notifications are sent.

MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
# tls | ssl | none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# --- Booking / scheduling ---
CALENDLY_URL=https://calendly.com/jamesbaldwindean2026/30min
# TEMPORARY DEMO LINK. Replace with Hyrum's real Calendly (or Google Calendar
# Appointment Schedule) URL before launch. Leave blank to hide the live
# scheduling widget and fall back to the request-only form.

# --- Social ---
INSTAGRAM_URL=
FACEBOOK_URL=

# --- Session / security ---
SESSION_SECURE_COOKIE=false
# Set to true once served over HTTPS in production.
RATE_LIMIT_BOOKING_MAX=5
RATE_LIMIT_BOOKING_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# --- Analytics (optional, off by default) ---
ANALYTICS_PROVIDER=
# Leave blank for no analytics. e.g. "plausible"
ANALYTICS_SITE_ID=
