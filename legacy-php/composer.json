{
    "name": "hyrumhaircuts/site",
    "description": "HyrumHaircuts portfolio and appointment-request website.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public public/web.php",
        "build-static": "php bin/build-static.php",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "create-admin": "php bin/create-admin.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
