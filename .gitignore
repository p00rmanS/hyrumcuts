# ---------------------------------------------------------------------------
# Environment / secrets. Only *.example files are ever committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Supabase CLI local state and any privileged keys/tokens
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*
!supabase/.env.example
*.secret
*.pem

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
/dist/
/coverage/
/playwright-report/
/test-results/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Legacy PHP app (kept for reference, not deployed). Private/runtime files.
# ---------------------------------------------------------------------------
/legacy-php/vendor/
/legacy-php/node_modules/
/legacy-php/.phpunit.cache/
/legacy-php/public/assets/css/app.css
/legacy-php/public/assets/css/app.css.map
/legacy-php/storage/database/*.sqlite*
/legacy-php/storage/logs/*.log
/legacy-php/storage/mail/*.eml
/legacy-php/storage/framework/sessions/*
!/legacy-php/storage/framework/sessions/.gitkeep
!/legacy-php/storage/logs/.gitkeep
!/legacy-php/storage/mail/.gitkeep
/legacy-php/public/uploads/*
!/legacy-php/public/uploads/.htaccess
!/legacy-php/public/uploads/gallery/
/legacy-php/public/uploads/gallery/*
!/legacy-php/public/uploads/gallery/.gitkeep
!/legacy-php/public/uploads/reviews/
/legacy-php/public/uploads/reviews/*
!/legacy-php/public/uploads/reviews/.gitkeep

# Real client media is never committed. It is uploaded through the CMS.
/legacy-php/public/assets/images/hyrum.jpg
/legacy-php/public/assets/video/*.mp4
/legacy-php/public/assets/video/*.webm

